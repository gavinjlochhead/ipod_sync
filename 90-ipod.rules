# udev rules for iPod Classic (Apple VID 05ac) with Rockbox installed.
# Rockbox presents the device as standard USB Mass Storage.
#
# Apple iPod Classic USB Product IDs:
#   1261 = iPod Classic 1st gen  (rare)
#   1262 = iPod Classic 2nd gen
#   1263 = iPod Classic 3rd gen
#   1265 = iPod Classic 5th gen (Video)
#   1266 = iPod Classic 5.5th gen
#   1267 = iPod Classic 6th/7th gen (most common)
#
# Rule 1: match each PID individually (| is not valid in ATTRS matching)
ACTION=="add", SUBSYSTEM=="block", ATTRS{idVendor}=="05ac", ATTRS{idProduct}=="1261", TAG+="systemd", ENV{SYSTEMD_WANTS}+="media-ipod.mount"
ACTION=="add", SUBSYSTEM=="block", ATTRS{idVendor}=="05ac", ATTRS{idProduct}=="1262", TAG+="systemd", ENV{SYSTEMD_WANTS}+="media-ipod.mount"
ACTION=="add", SUBSYSTEM=="block", ATTRS{idVendor}=="05ac", ATTRS{idProduct}=="1263", TAG+="systemd", ENV{SYSTEMD_WANTS}+="media-ipod.mount"
ACTION=="add", SUBSYSTEM=="block", ATTRS{idVendor}=="05ac", ATTRS{idProduct}=="1265", TAG+="systemd", ENV{SYSTEMD_WANTS}+="media-ipod.mount"
ACTION=="add", SUBSYSTEM=="block", ATTRS{idVendor}=="05ac", ATTRS{idProduct}=="1266", TAG+="systemd", ENV{SYSTEMD_WANTS}+="media-ipod.mount"
ACTION=="add", SUBSYSTEM=="block", ATTRS{idVendor}=="05ac", ATTRS{idProduct}=="1267", TAG+="systemd", ENV{SYSTEMD_WANTS}+="media-ipod.mount"

# Rule 2: fallback — match any block device with filesystem label IPOD.
# This catches Rockbox if the VID/PID changes, or any other device
# you label IPOD.  udisks2 sets ID_FS_LABEL when it probes the device.
ACTION=="add", SUBSYSTEM=="block", ENV{ID_FS_LABEL}=="IPOD", TAG+="systemd", ENV{SYSTEMD_WANTS}+="media-ipod.mount"
